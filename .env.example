# =============================================================================
# clinic_project — environment variable reference
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Lines starting with "#" are comments and are ignored by the loader.
# The loader splits each line on the FIRST "=" only, so values may contain "=".
# Real OS environment variables always take precedence over .env values.
# =============================================================================


# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------

# A long, random, secret string. NEVER commit the real value to source control.
SECRET_KEY=django-insecure-replace-me-with-a-real-secret-key

# Set to False in production.
DEBUG=True

# Comma-separated list of hosts/domains the app is allowed to serve.
ALLOWED_HOSTS=127.0.0.1,localhost


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------

# Backend used to send e-mail.
# "django.core.mail.backends.console.EmailBackend"  — prints to stdout (dev default)
# "django.core.mail.backends.smtp.EmailBackend"     — real SMTP (production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP server hostname (only used when backend is SMTP).
EMAIL_HOST=smtp.example.com

# SMTP port. Common values: 587 (STARTTLS), 465 (SSL), 25 (plain).
EMAIL_PORT=587

# Set to True to use STARTTLS encryption (recommended for port 587).
EMAIL_USE_TLS=True

# SMTP login credentials.
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-smtp-password

# The address that appears in the "From:" header of outgoing e-mails.
DEFAULT_FROM_EMAIL=noreply@clinic.example.com


# -----------------------------------------------------------------------------
# LLM / AI
# -----------------------------------------------------------------------------

# When True, LLM calls are mocked (returns a canned response) — safe for dev/CI.
# Set to False to make real API calls.
MOCK_LLM=True

# The LLM provider to use. Currently supported: "anthropic"
LLM_PROVIDER=anthropic

# API key for the chosen LLM provider.
LLM_API_KEY=sk-ant-replace-me

# The specific model name to invoke.
# Examples: claude-sonnet-4-6, claude-3-5-haiku-20241022
LLM_MODEL=claude-sonnet-4-6


# -----------------------------------------------------------------------------
# Google Calendar integration
# -----------------------------------------------------------------------------

# Master switch. Set to True only after completing the OAuth2 setup below.
GOOGLE_CALENDAR_ENABLED=False

# OAuth2 client credentials from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The redirect URI registered in Google Cloud Console.
# Must match exactly (scheme, host, port, path).
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback/


# -----------------------------------------------------------------------------
# Business logic
# -----------------------------------------------------------------------------

# How many minutes an unconfirmed appointment slot is held before being released.
SLOT_HOLD_MINUTES=5

# Maximum number of times the system will retry a failed outbound e-mail.
EMAIL_MAX_RETRIES=3
